{
    "name": "mediamonks/doctrine-extensions",
    "type": "library",
    "description": "Doctrine2 behavioral extensions which allows to transform (encrypt, decrypt, hash) your data automatically",
    "keywords": [
        "doctrine",
        "extensions",
        "transform",
        "transformable",
        "encrypt",
        "decrypt",
        "encryptable",
        "hash",
        "hashable",
        "hmac",
        "crypt",
        "cryptable"
    ],
    "homepage": "https://www.mediamonks.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Robert Slootjes",
            "email": "robert@mediamonks.com"
        },
        {
            "name": "Bas Bloembergen",
            "email": "basb@mediamonks.com"
        },
        {
            "name": "Edwin Luijten",
            "email": "edwin@mediamonks.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "gedmo/doctrine-extensions": "^3.0"
    },
    "require-dev": {
        "defuse/php-encryption": "^2.0",
        "phpunit/phpunit": "^9.5",
        "paragonie/halite": "^v5.0",
        "mockery/mockery": "^1.4",
        "doctrine/orm": "^3.8",
        "doctrine/common": ">=2.5"
    },
    "suggest": {
        "doctrine/orm": "^3.8 to use the extensions with the ORM",
        "defuse/php-encryption": "to use the Defuse Crypto transformers",
        "paragonie/halite": "to use the Halite symmetric transformer (requires ext-sodium)"
    },
    "autoload": {
        "psr-4": {
            "MediaMonks\\Doctrine\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MediaMonks\\Doctrine\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
           "dev-feature/gedmo-dev": "0.1-dev",
           "dev-feature/transform-context-field": "0.1-dev"
        }
    }
}
